# The image build context: source only.  Secrets, data, caches, and the
# design-shot vault never enter a layer — the runtime mounts arrive via
# compose.yaml.

.git
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage

# Node
web/node_modules
web/dist
web/coverage
web/.design-shots

# Secrets and durable state — mounted at RUNTIME, never baked.
var/
*.env
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Docs and tests are not runtime cargo.
tests/
docs/
*.md
!README.md
